@model IEnumerable<ToDoApp.Models.ToDoItem>

@{
    ViewData["Title"] = "My To-Do List";
}

<div class="container p-4">
    <div class="row pb-3">
        <div class="col-8">
            <h2 class="text-primary">📋 To-Do List</h2>
        </div>
        <div class="col-4 text-end">
            <a asp-controller="ToDo" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle-fill"></i> &nbsp; Add New Task
            </a>
        </div>
    </div>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Task Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr class="@(item.IsCompleted ? "table-success text-muted" : "")">
                        <td>
                            <span style="@(item.IsCompleted ? "text-decoration: line-through;" : "")">
                                @item.Title
                            </span>
                        </td>
                        <td>
                            <span class="badge @(item.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                @(item.IsCompleted ? "Completed" : "Active")
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">

                                <a asp-controller="ToDo" asp-action="ToggleComplete" asp-route-id="@item.Id" class="btn btn-sm btn-info mx-1">
                                    <i class="bi bi-check-circle"></i> Toggle
                            </a>

                                <a asp-controller="ToDo" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary mx-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                            </a>

                                <a asp-controller="ToDo" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger mx-1">
                                    <i class="bi bi-trash-fill"></i> Delete
                            </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3">No tasks found</td>
                </tr>
            }
        </tbody>
    </table>
</div>